# =========================================================
# CONTOH KONFIGURASI CACHE-CONTROL (untuk hosting berbasis Apache)
# Simpan sebagai file ".htaccess" di folder root website kamu.
# Ini memperbaiki temuan PageSpeed "Gunakan durasi cache yang efisien".
# Sesuaikan lokasi folder /app/images/ dengan struktur folder aslimu.
# =========================================================

<IfModule mod_expires.c>
  ExpiresActive On

  # Gambar - cache 1 tahun (nama file sebaiknya di-hash saat update)
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png  "access plus 1 year"
  ExpiresByType image/jpg  "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"

  # Font
  ExpiresByType font/woff2 "access plus 1 year"

  # Favicon
  ExpiresByType image/x-icon "access plus 1 year"

  # HTML - jangan di-cache lama karena sering berubah
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(webp|png|jpe?g|svg|woff2|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Aktifkan kompresi (jika belum aktif di server)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# =========================================================
# CATATAN:
# - Jika hosting kamu pakai Netlify / Vercel / Cloudflare Pages,
#   file .htaccess ini TIDAK berlaku — beri tahu saya platform
#   hosting-nya, saya buatkan konfigurasi yang sesuai (mis. file
#   _headers untuk Netlify, atau vercel.json untuk Vercel).
# - "immutable" + cache 1 tahun aman dipakai HANYA jika nama file
#   gambar berubah setiap kali kontennya diganti (mis. logo-v2.png).
#   Jika kamu meng-overwrite file dengan nama sama, turunkan durasi
#   cache-nya (mis. "access plus 1 month") supaya update tidak nyangkut
#   di cache browser pengunjung lama.
# =========================================================
